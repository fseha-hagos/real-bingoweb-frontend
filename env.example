# Frontend (Vercel) — public URLs only, no bot token here
NEXT_PUBLIC_API_URL=https://real-bingoweb-backend.onrender.com
NEXT_PUBLIC_SOCKET_URL=wss://bingo-tg-bot.onrender.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=winner_bingo_bot

# Backend URL for Next.js API proxy (server-side only)
BACKEND_URL=https://real-bingoweb-backend.onrender.com

# Local development (uncomment to use local backend)
# NEXT_PUBLIC_API_URL=https://real-bingoweb-backend.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://real-bingoweb-backend.onrender.com
# BACKEND_URL=https://real-bingoweb-backend.onrender.com

# TELEGRAM_BOT_TOKEN belongs on the BACKEND server only (Render, etc.)
# Do NOT add it to this frontend project.

# Optional: Enable debug logging
NEXT_PUBLIC_DEBUG=false
